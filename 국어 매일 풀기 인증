<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>국어 1일 1지문 사진 인증 스터디</title>
    <style>
        body {
            font-family: 'Apple SD Gothic Neo', sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        h2 { text-align: center; color: #2c3e50; }
        .box {
            margin-bottom: 25px;
            padding: 20px;
            background: #f9fbfb;
            border-radius: 8px;
            border: 1px solid #e1e8ed;
        }
        input[type="text"], input[type="file"], button {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            border-radius: 6px;
            border: 1px solid #ccc;
            margin-bottom: 10px;
            box-sizing: border-box;
        }
        button {
            background-color: #3498db;
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover { background-color: #2980b9; }
        .logout-btn { background-color: #e74c3c; margin-top: 5px; }
        .logout-btn:hover { background-color: #c0392b; }
        
        .feed-item {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .feed-header {
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
        }
        .feed-img {
            max-width: 100%;
            border-radius: 6px;
            margin-top: 5px;
        }
        .no-data { text-align: center; color: #888; font-size: 14px; }
    </style>
</head>
<body>

<div class="container">
    <h2>📚 국어 1일 1지문 사진 인증 스터디</h2>

    <!-- 로그인 화면 -->
    <div id="login-section" class="box">
        <h3>닉네임 설정하기</h3>
        <input type="text" id="username" placeholder="사용할 닉네임 입력 (예: 국어만세)">
        <button onclick="login()">입장하기</button>
    </div>

    <!-- 메인 인증 화면 -->
    <div id="main-section" class="box" style="display: none;">
        <h3>환영합니다, <span id="current-user"></span>님! 👋</h3>
        <p>오늘 푼 국어 지문 사진을 업로드해주세요.</p>
        
        <input type="file" id="photo-file" accept="image/*">
        <button onclick="certifyPhoto()">인증 사진 업로드 📸</button>
        <button class="logout-btn" onclick="logout()">로그아웃</button>
    </div>

    <!-- 스터디 피드 현황 화면 -->
    <div class="box">
        <h3>👥 오늘의 친구들 인증 피드</h3>
        <div id="feed-container">
            <!-- 동적으로 생성됨 -->
        </div>
    </div>
</div>

<script>
    const today = new Date().toISOString().split('T')[0];
    let currentUser = localStorage.getItem('current_user') || '';
    // 오늘의 인증 데이터를 로컬스토리지에서 가져옴 (배열 형태)
    let certs = JSON.parse(localStorage.getItem('certs_photo_' + today)) || [];

    window.onload = function() {
        if (currentUser) {
            document.getElementById('login-section').style.display = 'none';
            document.getElementById('main-section').style.display = 'block';
            document.getElementById('current-user').innerText = currentUser;
        }
        renderFeed();
    };

    function login() {
        const name = document.getElementById('username').value.trim();
        if (!name) {
            alert('닉네임을 입력해주세요!');
            return;
        }
        currentUser = name;
        localStorage.setItem('current_user', currentUser);
        location.reload();
    }

    function logout() {
        localStorage.removeItem('current_user');
        location.reload();
    }

    function certifyPhoto() {
        const fileInput = document.getElementById('photo-file');
        if (fileInput.files.length === 0) {
            alert('업로드할 사진을 선택해주세요!');
            return;
        }

        const file = fileInput.files[0];
        const reader = new FileReader();

        reader.onload = function(e) {
            const base64Image = e.target.result;

            // 이미 오늘 이 사용자가 올렸다면 덮어쓰기 혹은 추가 처리
            // 여기서는 새 인증 기록 추가
            const newCert = {
                user: currentUser,
                image: base64Image,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            };

            certs.unshift(newCert); // 최신 글이 위로 오도록
            localStorage.setItem('certs_photo_' + today, JSON.stringify(certs));

            alert('인증 사진이 성공적으로 업로드되었습니다! 🎉');
            fileInput.value = '';
            renderFeed();
        };

        reader.readAsDataURL(file);
    }

    function renderFeed() {
        const feedContainer = document.getElementById('feed-container');
        feedContainer.innerHTML = '';

        if (certs.length === 0) {
            feedContainer.innerHTML = '<p class="no-data">아직 오늘 인증한 친구가 없습니다. 첫 인증을 시작해보세요!</p>';
            return;
        }

        certs.forEach(item => {
            const div = document.createElement('div');
            div.className = 'feed-item';
            div.innerHTML = `
                <div class="feed-header">
                    <span>👤 ${item.user}</span>
                    <span style="font-size: 12px; color: #888;">${item.time}</span>
                </div>
                <img src="${item.image}" class="feed-img" alt="인증 사진">
            `;
            feedContainer.appendChild(div);
        });
    }
</script>

</body>
</html>
